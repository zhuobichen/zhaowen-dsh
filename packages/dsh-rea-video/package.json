{
  "name": "@zhuobichen/dsh-rea-video",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "rea-video CLI for DSH: reverse-engineer any video shot by shot, plus a workbench tab showing the latest breakdown.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "license": "MIT"
}
