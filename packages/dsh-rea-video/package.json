{
  "name": "@zhuobichen/dsh-rea-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "rea-video CLI for DSH: reverse-engineer any video shot by shot (filmed / AI / 3D / code) with a remake plan.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "license": "MIT"
}
