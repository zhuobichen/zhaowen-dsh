{
  "name": "@zhuobichen/dsh-image-gen",
  "version": "0.1.0",
  "description": "Agent-callable image generation/editing through the local Doubao desktop app (DSH plugin)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "client"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/naming.test.ts test/validate.test.ts test/queue.test.ts && node test/host.smoke.ts",
    "smoke:doubao": "npm run build && node test/live-doubao.smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "doubao",
    "image-generation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.10.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
