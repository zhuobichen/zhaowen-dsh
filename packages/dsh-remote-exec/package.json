{
  "name": "@zhuobichen/dsh-remote-exec",
  "version": "0.1.0",
  "description": "把指定的任务直接推到（一直开着的）腾讯云服务器上跑：远端执行、后台作业、双向传文件（DSH 插件）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs && node test/local-jobs.mjs",
    "test:live": "node test/live.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote",
    "ssh",
    "tencent-cloud",
    "offload"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.10.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
