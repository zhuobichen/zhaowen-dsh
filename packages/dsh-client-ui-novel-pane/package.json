{
  "name": "@zhuobichen/dsh-client-ui-novel-pane",
  "version": "0.1.0",
  "description": "Collapsible book-reading pane docked above the DSH composer (client half of @zhuobichen/dsh-novel-pane)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client",
    "deepseek-harness",
    "novel",
    "reader"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
