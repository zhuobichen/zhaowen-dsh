{
  "name": "@zhuobichen/dsh-import",
  "version": "0.2.0",
  "description": "把 Claude Code / Codex 的本地会话导入 DeepSeek Harness，并支持从既有 DSH 会话 fork（DSH 插件：扫描 + 导入 + fork + 用 DSH 自己的还原器校验）",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/fork-closers.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "claude-code",
    "codex",
    "session-import"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
