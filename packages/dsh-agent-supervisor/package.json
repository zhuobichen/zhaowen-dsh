{
  "name": "@zhuobichen/dsh-agent-supervisor",
  "version": "0.1.0",
  "description": "主管 Agent：管理其它会话（派活 / 查状态 / 改名 / 记记忆）的 DSH 插件，设计上没有删除能力",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/contract.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client",
    "deepseek-harness",
    "agent",
    "supervisor"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
