{
  "name": "@zhuobichen/dsh-design-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "设计工作台：把本机（和外部方法）的设计资料整理成三层——App 设计 / 前端设计 / 视频风格，点一下就能把「我要这种」引用给 AI",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "id": "dsh-design-workbench",
    "name": "设计工作台",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.4"
  }
}
