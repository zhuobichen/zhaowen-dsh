{
  "name": "@zhuobichen/dsh-design-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前端设计工作台：把本机已有的设计样式做成可横向对比的卡片，点一下就能把「我要这种」引用给 AI",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "id": "dsh-design-workbench",
    "name": "设计工作台",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
